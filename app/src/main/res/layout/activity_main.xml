<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D10">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Native ExoPlayer overlay: lives INSIDE this same activity/screen, so
         leaving it never destroys or reloads the WebView underneath —
         exiting a movie/series/channel returns you to exactly where you were. -->
    <FrameLayout
        android:id="@+id/native_player_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:keepScreenOn="true">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:show_buffering="when_playing"
            app:resize_mode="fit"
            app:use_controller="true"
            app:show_rewind_button="true"
            app:show_fastforward_button="true"
            app:show_previous_button="false"
            app:show_next_button="false"
            app:repeat_toggle_modes="none" />

        <TextView
            android:id="@+id/titleOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="18dp"
            android:background="#B0000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:textColor="#FFB020"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="6dp" />

        <LinearLayout
            android:id="@+id/topControlsBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/exitPlayerBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:background="#B0000000"
                android:textColor="#FFB020"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:elevation="6dp"
                android:text="✕ Salir" />
        </LinearLayout>

        <!-- Screen-format ("gear") button — placed bottom-right, right above
             the player's own control bar, where a settings cog is expected. -->
        <Button
            android:id="@+id/aspectBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="72dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="#B0000000"
            android:textColor="#FFB020"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:elevation="6dp"
            android:text="⚙" />

        <ProgressBar
            android:id="@+id/loadingSpinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#FFB020" />

    </FrameLayout>

</FrameLayout>
